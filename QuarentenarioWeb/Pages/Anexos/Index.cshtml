@page
@model QuarentenarioWeb.Pages.Anexos.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Anexos</h1>

<p>
    <a asp-page="Create" asp-route-idBoletim="@Model.IdBoletim" asp-route-idAnalise="@Model.IdAnalise">Criar Novo</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Anexo[0].NomeArquivo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Anexo[0].NomeArmazenado)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Anexo[0].TipoConteudo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Anexo[0].IdAnaliseNavigation)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Anexo[0].IdBoletimNavigation)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Anexo) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.NomeArquivo)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.NomeArmazenado)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TipoConteudo)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IdAnaliseNavigation!.Descricao)
            </td>
            <td>
                    @Html.DisplayFor(modelItem => item.IdBoletimNavigation!.Descricao)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Editar</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Detalhes</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Excluir</a> |
                <a asp-page="./Download" asp-route-id="@item.Id">Download</a>
            </td>
        </tr>
}
    </tbody>
</table>
<div>
    <a asp-page="/Boletins/Index">Voltar à lista de Boletins</a> |
    <a asp-page="/Analises/Index" asp-route-id="@Model.IdBoletim">Voltar à lista de Análises</a>
</div>