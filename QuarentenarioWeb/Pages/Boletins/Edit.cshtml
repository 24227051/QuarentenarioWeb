@page
@model QuarentenarioWeb.Pages.Boletins.EditModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Editar</h1>

<h4>Boletim</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Boletim.Id" />
            <div class="form-group">
                <label asp-for="Boletim.IdMaterial" class="control-label"></label>
                <select asp-for="Boletim.IdMaterial" class="form-control" asp-items="ViewBag.IdMaterial" >
                    <option value="">-- Selecione um Material --</option>
                </select>
                <span asp-validation-for="Boletim.IdMaterial" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Boletim.IdPais" class="control-label"></label>
                <select asp-for="Boletim.IdPais" class="form-control" asp-items="ViewBag.IdPais">
                    <option value="">-- Selecione um País --</option>
                </select>
                <span asp-validation-for="Boletim.IdPais" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Boletim.Descricao" class="control-label"></label>
                <input asp-for="Boletim.Descricao" class="form-control" />
                <span asp-validation-for="Boletim.Descricao" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Boletim.DataInicio" class="control-label"></label>
                <input asp-for="Boletim.DataInicio" class="form-control" />
                <span asp-validation-for="Boletim.DataInicio" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Boletim.DataTermino" class="control-label"></label>
                <input asp-for="Boletim.DataTermino" class="form-control" />
                <span asp-validation-for="Boletim.DataTermino" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="Boletim.Finalizada" /> @Html.DisplayNameFor(model => model.Boletim.Finalizada)
                </label>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="Boletim.Positivo" /> @Html.DisplayNameFor(model => model.Boletim.Positivo)
                </label>
            </div>
            <div class="form-group">
                <input type="submit" value="Salvar" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Voltar à lista</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
